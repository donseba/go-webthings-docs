{{/*
@dot donseba/go-webthings-docs/internal/website.DocsNavPage
*/}}
{{ define "sidebar.gohtml" }}
<aside id="docs-sidebar" class="sticky top-16 h-[calc(100vh-4rem)] w-[240px] flex-none content-start gap-5 overflow-auto border-r border-slate-800/80 px-4 py-6 max-[900px]:static max-[900px]:h-auto max-[900px]:w-auto max-[900px]:border-r-0 max-[900px]:border-b max-[900px]:border-slate-800 {{ if .Nav }}grid{{ else }}hidden{{ end }}"{{ oobAttr }}>
    {{ with .Head }}
        <div class="grid gap-3 border-b border-slate-800/80 px-1 pb-5">
            <a class="grid gap-2 text-slate-50" href="{{ .URL }}" hx-get="{{ .URL }}" hx-target="#content" hx-push-url="true">
                {{ if .Image }}
                    <img class="block h-9 w-auto max-w-full justify-self-start object-contain" src="{{ .Image }}" alt="" height="36">
                {{ else if .Icon }}
                    <span class="module-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><use href="/assets/img/icons.svg#{{ .Icon }}"></use></svg></span>
                {{ end }}
                <span>
                    <strong class="block font-mono text-sm font-bold uppercase tracking-wide">{{ .Title }}</strong>
                    <small class="block text-xs text-slate-400">{{ .Subtitle }}</small>
                </span>
            </a>
            {{ with .SourceURL }}<a class="justify-self-start font-mono text-xs lowercase text-slate-400 hover:text-slate-100" href="{{ . }}" target="_blank">source ↗</a>{{ end }}
        </div>
    {{ end }}
    {{ range .Groups }}
        {{ $group := . }}
        <section class="grid gap-1.5">
            <h2 class="mb-1 px-3 font-mono text-sm font-extrabold uppercase tracking-wide text-sky-400">{{ $group }}</h2>
            {{ range $.Nav }}
                {{ if eq .Group $group }}
                    <a class="block border-l-2 border-y-0 border-r-0 px-3 py-2 text-[0.9rem] {{ if .Active }}border-l-sky-400 bg-slate-900/70 font-semibold text-slate-100{{ else }}border-l-transparent text-slate-400 hover:border-l-slate-600 hover:bg-slate-900/50 hover:text-slate-100{{ end }}"
                       href="{{ .Path }}"
                       hx-get="{{ .Path }}" hx-target="#content" hx-push-url="true"
                       {{ if .Active }}aria-current="page"{{ end }}>{{ .Label }}</a>
                {{ end }}
            {{ end }}
        </section>
    {{ end }}
</aside>
{{ end }}
{{ template "sidebar.gohtml" . }}
