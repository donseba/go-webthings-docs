<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .SEO.Title }}</title>
    <meta name="description" content="{{ .SEO.Description }}">
    <link rel="canonical" href="{{ .SEO.Canonical }}">
    <meta property="og:type" content="{{ .SEO.Type }}">
    <meta property="og:site_name" content="{{ .SEO.SiteName }}">
    <meta property="og:title" content="{{ .SEO.Title }}">
    <meta property="og:description" content="{{ .SEO.Description }}">
    <meta property="og:url" content="{{ .SEO.Canonical }}">
    <meta property="og:image" content="{{ .SEO.Image }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ .SEO.Title }}">
    <meta name="twitter:description" content="{{ .SEO.Description }}">
    <meta name="twitter:image" content="{{ .SEO.Image }}">
    <link rel="icon" href="/assets/img/favicon.ico" sizes="any">
    <script src="https://unpkg.com/htmx.org@4.0.0/dist/htmx.min.js"></script>
    <link rel="stylesheet" href="/assets/css/styles.css?v=20261026">
    <script>
        function scrollToCurrentHash() {
            if (!window.location.hash) {
                return;
            }
            const target = document.querySelector(window.location.hash);
            if (target) {
                target.scrollIntoView({ block: "start" });
            }
        }

        // htmx 4 fires htmx:after:swap on the element that made the request.
        // The swap target is in detail.ctx, as a selector after HX-Retarget.
        function swappedContent(event) {
            let target = event.detail && event.detail.ctx && event.detail.ctx.target;
            if (typeof target === "string") {
                target = document.querySelector(target);
            }

            return Boolean(target && target.id === "content");
        }

        document.addEventListener("htmx:after:swap", function (event) {
            if (swappedContent(event)) {
                requestAnimationFrame(scrollToCurrentHash);
            }
        });
        window.addEventListener("hashchange", scrollToCurrentHash);
        window.addEventListener("load", scrollToCurrentHash);
    </script>
    <script src="/assets/js/code-highlight.js?v=20261026" defer></script>
</head>
{{/* htmx 4 swaps a 4xx or 5xx answer and pushes its URL; leave the page as it is, as htmx 2 did. */}}
<body class="docs-body m-0 min-h-screen bg-[#0b111a] font-sans text-slate-100" hx-status:4xx:inherited="swap:none push:false" hx-status:5xx:inherited="swap:none push:false">
    {{ template "header.gohtml" .Header }}
    <div class="mx-auto flex max-w-[1440px] items-start max-[900px]:flex-col max-[900px]:items-stretch">
        {{ template "rail.gohtml" .Rail }}
        {{ template "sidebar.gohtml" .Sidebar }}
        <main id="content" class="content min-w-0 max-w-[880px] flex-1 px-10 pb-28 pt-10 max-[900px]:px-5 max-[900px]:pb-20 max-[900px]:pt-8">
            {{ content }}
        </main>
    </div>
</body>
</html>

